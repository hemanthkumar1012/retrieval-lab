DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Leave REDIS_URL empty to keep the semantic cache and rate limits in Postgres (what the
# Vercel deploy does). docker compose points the API at its own Redis container instead.
REDIS_URL=redis://localhost:6379/0

# any OpenAI-compatible chat endpoint (OpenAI, Groq, Together, vLLM, Ollama...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# for Gemini's thinking models set this to low; leave empty for OpenAI
LLM_REASONING_EFFORT=

CACHE_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# number of HNSW candidates scanned per batch (pgvector hnsw.ef_search)
HNSW_EF_SEARCH=100

# Public deployment. Set ADMIN_TOKEN: it is required (X-Admin-Token header) for /ingest and
# DELETE /cache. RATE_LIMIT_PER_MINUTE is per client IP on /search and /ask, 0 disables it.
ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=30
# only if a frontend on another origin calls the API, e.g. https://my-app.vercel.app
CORS_ORIGINS=
